# Environment — copy to `.env.local` for local development, or set in the
# Vercel project settings for a deployment. `.env*` is git-ignored; this file
# is the only one that is committed.

# ---------------------------------------------------------------- contact form
# Optional. When set, the contact form POSTs JSON to this endpoint instead of
# only preparing a mailto: draft. Any form backend that accepts JSON works
# (Formspree, Basin, Getform, Formbricks, a serverless function, ...).
#
# When unset, the form validates, saves a local draft, and hands the brief to
# the visitor's mail client. Nothing breaks either way.
#
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# ------------------------------------------------------------------- payments
# Razorpay. BOTH values are server-only — they are read by the functions in
# `api/` and must never be prefixed with VITE_, which would inline them into
# the public JavaScript bundle.
#
# Without them the site still builds and runs; /pay shows an honest "gateway
# not connected" notice instead of a dead pay button.
#
# Test keys start with `rzp_test_`; anything else is treated as live.
# Dashboard → Account & Settings → API Keys → Generate key.
#
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
